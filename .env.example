# Copy to .env.local and fill in from your Supabase project settings
# (or the values `npx supabase start` prints for local dev).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client, never NEXT_PUBLIC_. Bypasses RLS entirely.
# Used by lib/supabase/admin.ts — the public /review/[token] reviewer-link page (no
# login) and the extended-response auto-delete cron job both need to read/write rows
# with no authenticated user in context. Get it from Settings -> API -> Secret keys.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Powers extended-response scoring (lib/claude/score-extended-response.ts)
# — scores a submitted response against the 4 GED RLA rubric traits immediately after
# she submits it. Get a key from https://console.anthropic.com.
ANTHROPIC_API_KEY=

# Server-only. Shared secret checked by the auto-delete cron route
# (app/api/cron/auto-delete-extended-responses/route.ts) so it can't be triggered by
# anyone who finds the URL. Generate any long random string; Vercel Cron sends it back
# as `Authorization: Bearer <value>` when set as this project's CRON_SECRET env var.
CRON_SECRET=

# Optional. Powers the "Search YouTube" box on the admin /videos page (one-off lookups
# only, never called at lesson-load time). Free, quota-limited — get a key from
# https://console.cloud.google.com by enabling the YouTube Data API v3. Without it, the
# search box shows a setup message but manual video entry still works fine.
YOUTUBE_API_KEY=
