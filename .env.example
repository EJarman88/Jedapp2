# Copy to .env.local and fill in from your Supabase project settings
# (or the values `npx supabase start` prints for local dev).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client. Used for privileged operations that must
# bypass RLS (e.g. Phase 6 reviewer-link mechanics). Not used by anything in Phase 2.
SUPABASE_SERVICE_ROLE_KEY=
